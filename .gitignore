# OnePlan — корень репозитория: CLAUDE.md, docs/, web/ (приложение), прототип (только html/js).
.DS_Store
._*
Thumbs.db

# Секреты и личные файлы — НИКОГДА в git
web/.env.local
web/.env*.local
*.env
.env
*.docx
~$*
*.pem
*.key

# Сборка и зависимости
web/node_modules/
web/.next/
web/out/
web/build/
web/coverage/
