# Скопируйте в .env.local и подставьте значения из Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Только для демо-стенда: предзаполняет форму входа демо-учёткой (realtor@one-plan.pro). В проде не включать.
# NEXT_PUBLIC_DEMO_LOGIN=1

# ИИ-перевод в чате кабинета застройщика (Anthropic). Без ключа перевод отключён (показывается оригинал).
# ANTHROPIC_API_KEY=sk-ant-...

# Google Maps Platform: ключ сайта (HTTP referrer: one-plan.pro, localhost) для подсказок адреса Places API (New) в браузере
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Отдельный серверный ключ (ограничение по IP сервера) для Geocoding API: точка → адрес. Без него — Nominatim
GOOGLE_MAPS_SERVER_KEY=

# CRM: мастер-ключ шифрования контактов клиентов — `openssl rand -base64 32`; хранить копии вне сервера
CRM_MASTER_KEY=
